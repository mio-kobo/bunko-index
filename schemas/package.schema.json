{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bunko package version metadata (v1)",
  "type": "object",
  "required": [
    "name",
    "version",
    "publisher",
    "description",
    "repository",
    "source_commit",
    "release_id",
    "archive",
    "sha256",
    "license",
    "mio",
    "dependencies",
    "platforms"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^(?:(?=[a-z0-9-]{1,39}(?:/|(?![\\s\\S])))[a-z0-9]+(?:-[a-z0-9]+)*/(?=[a-z0-9-]{1,39}(?:/|(?![\\s\\S])))[a-z0-9]+(?:-[a-z0-9]+)*)(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]{0,8})(?:\\.(?:0|[1-9][0-9]{0,8})){2})(?![\\s\\S])"
    },
    "publisher": {
      "type": "string",
      "pattern": "^(?:github:[a-z0-9]+(?:-[a-z0-9]+)*)(?![\\s\\S])"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f][^\\x00-\\x1f\\x7f]*(?![\\s\\S])"
    },
    "repository": {
      "type": "string",
      "pattern": "^(?:https://github\\.com/[a-z0-9-]+/[A-Za-z0-9_.-]+)(?![\\s\\S])"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}(?![\\s\\S])"
    },
    "archive": {
      "type": "string",
      "pattern": "^(?:https://api\\.github\\.com/repos/[a-z0-9-]+/[A-Za-z0-9_.-]+/releases/assets/[1-9][0-9]{0,19})(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])"
    },
    "license": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9.+-]{0,79})(?![\\s\\S])"
    },
    "mio": {
      "type": "object",
      "required": [
        "min",
        "before"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^(?:(?:0|[1-9][0-9]{0,8})(?:\\.(?:0|[1-9][0-9]{0,8})){2})(?![\\s\\S])"
        },
        "before": {
          "type": "string",
          "pattern": "^(?:(?:0|[1-9][0-9]{0,8})(?:\\.(?:0|[1-9][0-9]{0,8})){2})(?![\\s\\S])"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:(?=[a-z0-9-]{1,39}(?:/|(?![\\s\\S])))[a-z0-9]+(?:-[a-z0-9]+)*/(?=[a-z0-9-]{1,39}(?:/|(?![\\s\\S])))[a-z0-9]+(?:-[a-z0-9]+)*)(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:(?:0|[1-9][0-9]{0,8})(?:\\.(?:0|[1-9][0-9]{0,8})){2})(?![\\s\\S])"
      }
    },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "linux": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "x86_64",
              "arm64"
            ]
          }
        },
        "macos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "x86_64",
              "arm64"
            ]
          }
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "x86_64",
              "arm64"
            ]
          }
        }
      }
    }
  }
}
